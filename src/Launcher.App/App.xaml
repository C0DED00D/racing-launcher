<Application x:Class="Launcher.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <FontFamily x:Key="DisplayFont">Bahnschrift, Segoe UI</FontFamily>
        <SolidColorBrush x:Key="Ink" Color="#F5F3EE"/>
        <SolidColorBrush x:Key="InkDim" Color="#9AA0AA"/>
        <SolidColorBrush x:Key="Accent" Color="#FFD23F"/>
    </Application.Resources>
</Application>
